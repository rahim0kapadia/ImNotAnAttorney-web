# Auto-detect text files and normalize to LF
* text=auto eol=lf

# Source code
*.md text diff=markdown
*.json text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.ts text
*.tsx text
*.css text
*.scss text
*.html text
*.yml text
*.yaml text
*.toml text
*.xml text
*.svg text
*.env text
*.env.* text

# Shell scripts
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.pdf binary
*.epub binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Media
*.mp4 binary
*.mp3 binary
*.wav binary
*.webm binary

# Data
*.db binary
*.sqlite binary
*.db-shm binary
*.db-wal binary

# Lock files — exact regeneration, no diff noise
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary