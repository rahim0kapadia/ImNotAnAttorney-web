# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deno (deno-bin used locally for Edge Function tests; lockfile not committed)
deno.lock

.vercel
.env*.local

# IDE
.idea/
.vscode/

# .claude/: ignore most agent state but keep shared commands in repo.
# Must use .claude/* (children) not .claude/ (directory) because gitignore
# cannot negate a fully-ignored directory.
.claude/*
!.claude/commands/

# Tool artifacts
.review-state.json

# Generated images (reproducible from scripts/)
scripts/gbp-cover-1024x576.png
scripts/gbp-cover-v2-1024x576.png
scripts/gbp-profile-500x500.png
scripts/gbp-photos/

# Test reports
test-reports/

# Reviewer fan-out output (reviewer-fanout.mjs writes per-run dirs here)
docs/reviews/

# Bulk data dumps from CourtListener case law verification pipeline
# (multi-GB compressed CSV dumps — re-downloaded as needed via scripts)
data/bulk-verify/cl-bulk/
*.csv.bz2

# Large JSON data files (exceed GitHub 100MB limit)
data/bulk-verify/statute-case-law-dump.json
data/bulk-verify/good-law-graph/appeal-citing-map.json

# USSC sentencing data (multi-GB .dat/.sas/.sps files + zip archives)
data/bulk-verify/external-intel/ussc/
data/bulk-verify/external-intel/**/*.zip
data/bulk-verify/external-intel/*.zip

# JUSTFAIR data (1.3GB CSV + generated SQL output)
data/external-intel/justfair/FinalDataset.csv
data/external-intel/justfair/sql-output/
*.dat
*.sas
*.sps

# Large HTML caches and SQL dumps (re-generated from scripts)
data/bulk-verify/external-intel/*-cache.html
data/bulk-verify/external-intel/*-upserts.sql
data/bulk-verify/external-intel/bjs-extracted/

# Pipeline logs (ephemeral)
logs/
data/pipeline-output.log
data/bench-jury-run.log
data/tmp-*.sql
data/tmp-*.html

# Test results
test-results/

# Local cache directories
.cap-cache/
# CocoIndex Code (ccc)
/.cocoindex_code/
.cocoindex_code/

# Caveman compression backups (from /compress skill)
CLAUDE.original.md
*.original.md

# Hook artifacts that occasionally leak into repo root
UsersemailAppData*.json

# Scratch / one-off run artifacts
aba-*.txt
test-aba-*.txt
tsc-out.txt
monitor-aba.sh
data/bulk-classify-full-corpus.log
data/enrich-vectors-run.log

# Session scratch files (hundreds accumulate from agent sessions)
.tmp-*
tmp-*
.tmp/
.fjc-tmp/

# Browser session credentials — NEVER commit
.quora-cookies*
.reddit-cookies*
.playwright-*-profile/

# Bulk external intelligence datasets (reproducible via scripts/download-all-external-datasets.mjs)
data/external-intel/
data/bulk-verify/external-intel/virginia-court-data/
data/bulk-verify/external-intel/cl-*-progress.json
data/bulk-verify/external-intel/*-enrichment.sql

# Generated defense-intelligence outputs (regenerated from scripts)
data/defense-intelligence/classify-existing-opinions.sql
data/defense-intelligence/gold-set-cluster-ids.json

# FL statutes seed previews (dry-run output)
data/statutes-fl-*.jsonl
