# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase direct DB access (for DDL migrations — schema changes, indexes, triggers)
# Connect with: psql "postgresql://postgres:[DB_PASSWORD]@db.[REF].supabase.co:5432/postgres"
# SUPABASE_DB_PASSWORD=your-db-password

# Supabase management API token (for supabase CLI / edge function deployment)
SUPABASE_ACCESS_TOKEN=sbp_...

# Supabase compute tier — sets safe work_mem / maintenance_work_mem ceilings
# in scripts/lib/pg-bulk-defaults.mjs. Must match the project's actual tier.
# Valid: nano, micro, small, medium, large, xlarge, 2xlarge, 4xlarge,
# 8xlarge, 12xlarge, 16xlarge (or `ci_*` variant ids). Default: small.
# Re-check after tier changes:
#   curl -H "Authorization: Bearer $SUPABASE_ACCESS_TOKEN" \
#     https://api.supabase.com/v1/projects/<ref>/billing/addons
SUPABASE_COMPUTE_TIER=small

# Stripe
# Note: Site uses inline price_data, not Stripe Price IDs
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Live-mode keys — used when a tier's `live: true` flag is set in src/lib/tiers.ts
STRIPE_SECRET_KEY_LIVE=sk_live_...
STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# Resend (email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@imnotanattorney.com

# Resend webhook verification secrets (from Resend dashboard → Webhooks)
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
RESEND_INBOUND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Operator notification email (receives order alerts, intake notifications, etc.)
OPERATOR_EMAIL=your-email@example.com

# Site URL (used for email links, API callbacks, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://imnotanattorney.com

# Claude API (report generation via Supabase Edge Function)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Admin dashboard password
ADMIN_PASSWORD=generate-a-strong-password-here

# Operator authentication — generate with: openssl rand -hex 32
OPERATOR_SECRET=your-32-char-operator-secret-here

# Cron auth — custom name to avoid collision with Vercel's auto-injected CRON_SECRET
# CRON_AUTH_TOKEN=your-cron-auth-token-here

# cron-job.org API key (external cron provider — free tier alternative to Vercel Pro)
CRONJOB_API_KEY=your-cronjob-api-key

# GitHub PAT for dispatching engine worker workflow
# Create at: GitHub Settings -> Developer settings -> Fine-grained tokens
# Repo: rahim0kapadia/ImNotAnAttorney-engine, Permission: Actions (read+write)
ENGINE_DISPATCH_PAT=github_pat_...
# GitHub PAT for blog post publishing (push to repo)
# Create at: GitHub Settings -> Developer settings -> Fine-grained tokens
# Repo: rahim0kapadia/ImNotAnAttorney-web, Permission: Contents (read+write)
GITHUB_TOKEN=ghp_...

# Twilio (SMS notifications — optional, used for operator alerts)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1...

# IndexNow (search engine instant-indexing on new blog posts — optional)
INDEXNOW_KEY=your-indexnow-key

# QA / internal testing (checkout bypass for internal orders — never use in production data)
INTERNAL_QA_COUPON_ID=promo_...
INTERNAL_QA_EMAIL=qa@example.com

# Analytics & tracking (client-side — safe to expose)
NEXT_PUBLIC_GA_ID=G-...
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-...
