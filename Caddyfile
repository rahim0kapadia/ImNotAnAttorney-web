# Auto-HTTPS (Let's Encrypt) once DNS points imnotanattorney.com at this box.
# Caddy fetches + renews certs automatically. Multi-site = add another block.

imnotanattorney.com, www.imnotanattorney.com {
	encode zstd gzip
	reverse_proxy inaa:3000 {
		# ride out the ~1s upstream swap during rolling deploys
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

# Plain-HTTP on the bare IP: uptime monitor hits the app itself (not just Caddy).
http://152.53.194.188 {
	reverse_proxy inaa:3000
}
